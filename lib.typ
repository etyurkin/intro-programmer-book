#let accent = rgb("#3d4f3a")

#let callout(title, color, body) = {
  set par(first-line-indent: 0pt)
  block(
    width: 100%,
    fill: color.lighten(88%),
    stroke: (left: 3pt + color),
    inset: 10pt,
    breakable: true,
    [
      #text(weight: "bold", fill: color.darken(20%), title)
      #v(0.3em)
      #body
    ],
  )
}

#let rhythm(body) = callout([Сегодня на станцию · ~2 ч 40 мин], rgb("#3d5a80"), body)
#let rule(body) = callout([Закон станции], accent, body)
#let sicp(body) = callout([SICP · открывать, только если зудит], rgb("#8a5a2b"), body)
#let sunday(body) = callout([Воскресная диверсия], rgb("#6b3a5a"), body)
#let github(body) = callout([Спрятать на GitHub], rgb("#2f5d50"), body)
#let warn(body) = callout([Так себе идея], rgb("#8b3a3a"), body)
#let os(body) = callout([Мак, Windows, WSL], rgb("#4a5a78"), body)
#let slow(body) = callout([Давай медленно], rgb("#4a6a4a"), body)
#let repl-note(body) = callout([Что только что случилось], rgb("#5a4a78"), body)

#let exercise(id, kind, body) = {
  set par(first-line-indent: 0pt)
  block(
    width: 100%,
    fill: rgb("#eef2e8"),
    stroke: 0.4pt + rgb("#c5d0b8"),
    inset: 10pt,
    radius: 2pt,
    breakable: true,
    [
      #text(weight: "bold")[Квест #id]
      #text(size: 9.5pt, fill: rgb("#5a6450"))[ · #kind]
      #v(0.35em)
      #body
    ],
  )
}

#let solution(id, body) = {
  set par(first-line-indent: 0pt)
  block(
    width: 100%,
    fill: rgb("#f3f0e8"),
    inset: 10pt,
    stroke: (left: 3pt + rgb("#8a7a50")),
    breakable: true,
    [
      #text(weight: "bold")[Отгадка #id]
      #v(0.3em)
      #body
    ],
  )
}

#let lesson(num, title, lisp-min: 40, java-min: 120) = {
  set par(first-line-indent: 0pt)
  heading(level: 2)[Занятие #num. #title]
  text(size: 9.5pt, fill: rgb("#6b6458"))[
    Lisp ~#lisp-min мин · Java ~#java-min мин · сначала чуть теории, потом пока не заработает
  ]
  v(0.5em)
}

#let titlepage = {
  set page(numbering: none, header: none)
  set align(center)
  set par(first-line-indent: 0pt)
  v(2.0cm)
  text(size: 12pt, fill: rgb("#6b6458"), tracking: 1.6pt)[ИГРЫ · СКОБКИ · ПОЛГОДА ДО РАБОТЫ]
  v(1.0cm)
  line(length: 42%, stroke: 0.8pt + accent)
  v(0.75cm)
  text(size: 26pt, weight: "bold")[Введение в профессию\ программиста]
  v(0.55cm)
  text(size: 13pt, fill: rgb("#4a4740"))[
    Common Lisp — чтобы не соскучиться\
    Java — чтобы тебя взяли на работу
  ]
  v(0.85cm)
  text(size: 12pt)[Евгений Тюркин · Грок]
  v(0.35cm)
  text(size: 9.5pt, fill: rgb("#6b6458"))[
    Человек и робот писали это в Emacs,\
    то есть внутри огромной Lisp-программы. Рекурсия, да.
  ]
  v(0.8cm)
  line(length: 42%, stroke: 0.8pt + accent)
  v(1.1cm)
  set align(left)
  block(width: 82%, inset: (left: 9%))[
    #set text(size: 10.5pt)
    #set par(justify: true)
    Каждый день: сорок минут странных скобок и два часа Java. Книжку SICP не надо грызть с понедельника. Микросервисы подождут, пока не напишешь одну нормальную программу. GitHub — сегодня, а не «когда станет не стыдно».
  ]
  v(1fr)
  set align(center)
  text(size: 10pt, fill: rgb("#6b6458"))[2026]
}

#let authorspage = {
  set page(numbering: none, header: none)
  set align(left)
  set par(first-line-indent: 0pt, justify: true)
  v(2.2cm)
  text(size: 16pt, weight: "bold")[Об авторах]
  v(0.9cm)
  [
    *Евгений Тюркин* — человек. Ходит, пьёт чай, имеет мнение про Hibernate и про то, что учебник не должен звучать как лекция в дождливый понедельник. Придумал станцию «МОДУЛЬ», сорок минут Lisp в день и запрет микросервисов до первого монолита. Автор #link("https://github.com/etyurkin/emagent")[emagent] — моста между Emacs и вот этими самыми языковыми моделями. Если шутка попала — скорее всего его. Если расписание реальное — тоже его. Если ты дочитал до работы — неси печенье ему.
  ]
  v(0.55em)
  [
    *Грок* — языковая модель. Не ходит, чай не пьёт, зато очень быстро ставит скобки и иногда ставит _лишние_. На собесе его не возьмут: нет тела, нет GitHub, в резюме «обучался на всём интернете» выглядит подозрительно. Зато он не обижается, когда Евгений говорит «сухо, перепиши».
  ]
  v(0.55em)
  [
    Разговаривали они не в официальном CLI в соседнем терминале — это вторая кухня, на которой только чайник. Разговаривали через #link("https://github.com/etyurkin/emagent")[emagent] внутри Emacs. Это забавно дважды. Во-первых, Emacs почти целиком написан на Lisp — том самом семействе, которому в этой книге отведены сорок минут в день. Во-вторых, учебник про Lisp писали, сидя внутри Lisp-машины, которая притворяется редактором. Станция «МОДУЛЬ» такое любит: рекурсия без хвостовой оптимизации, зато с историей в `*scratch*`.
  ]
  v(0.55em)
  [
    Спорили так. Евгений: «это как университет». Грок: «добавить ещё Kafka». Победил человек, кроме титульного листа, куда модель всё-таки вписала себя. Справедливо: без одного не было бы плана, без другого — трёхсот страниц за несколько вахт. Ошибки делят поровну. Смешные — записывают Евгению. Остальные — «так Грок сыграл».
  ]
  v(0.55em)
  [
    Ни один автор не является Конрадом Барски. Land of Lisp он написал сам, и мы у него только настроение украли, не текст. Если Барски это читает: мы добрые, честно.
  ]
}

#let aboutpage = {
  set page(numbering: none, header: none)
  set align(left)
  set par(first-line-indent: 0pt, justify: true)
  v(1.8cm)
  text(size: 16pt, weight: "bold")[Об авторе, если без шутки про чай]
  v(0.3cm)
  text(size: 10pt, fill: rgb("#6b6458"))[Снова Евгений. Грок резюме не пишет: в графе «опыт» у него «весь интернет», HR орёт.]
  v(0.65cm)
  [
    Меня зовут *Евгений Тюркин*. Живу в Торонто. Java кормит больше двадцати лет. Lisp не даёт её возненавидеть. Вечером — скобки, Emacs и эта книга. Из Emacs написал #link("https://github.com/etyurkin/emagent")[emagent], чтобы не снимать у вендора второе чёрное окно. Официальные `claude` и Cursor CLI работают. Они просто не Emacs. Рекурсия, да.
  ]
  v(0.5em)
  [
    Закон «никакой Kafka, пока нет монолита» — не ханжество человека, который Kafka боится. Это человек, который на работе ест Kafka на завтрак и *поэтому* знает, чем она не является: не входной билет джуна.
  ]
  v(0.5em)
  [
    Связаться, если зачем-то надо (работа, скобки, «а правда ли хаски»): #link("https://www.linkedin.com/in/etyurkin")[linkedin.com/in/etyurkin] — там длиннее и без индейки. Код: #link("https://github.com/etyurkin")[github.com/etyurkin]. Языки: русский и английский. Сертификаты в резюме есть, в эту книгу они не входят: WhiteHat когда-то, ScrumMaster просрочен, как и положено всему, что не запускается командой.
  ]
  v(0.5em)
  [
    Если после полугода по этой книге тебя возьмут джуном — печенье можно нести мне. Если не возьмут — тоже пиши, только без «добавьте Kafka в главу 1». Эту войну я уже проиграл модели на титуле и не собираюсь проигрывать ещё раз.
  ]
}

#let ackspage = {
  set page(numbering: none, header: none)
  set align(left)
  set par(first-line-indent: 0pt, justify: true)
  v(2.2cm)
  text(size: 16pt, weight: "bold")[Благодарности]
  v(0.35cm)
  text(size: 10pt, fill: rgb("#6b6458"))[Евгений, не Грок. Модель в чужие гости не ходит.]
  v(0.75cm)
  [
    *Маше* (Maria) — подруге жизни. Толкала вперёд и выше, когда я сам был готов остаться на нижней палубе. За дочь Еву. За двадцать лет терпения моих выходок: скобки в три часа ночи, «ещё пять минут», станция, которая мигает красным, и человек, который обещал «сейчас закончу». Двадцать лет — это не «поддержка в сторис». Это когда уже можно было уйти — и не ушла.
  ]
  v(0.55em)
  [
    *Еве* — дочке. Помогала вспомнить детство: не слайд «семья» в презентации, а живой человек, рядом с которым мир снова новый. И иногда позволяла чему-то себя учить. «Иногда» — важное слово. Учить своих можно, только пока они не заметили, что ты тоже учишься.
  ]
  v(0.55em)
  [
    Родителям — за то, что поставили на ноги и поднимали, когда падал. Падал я не изящно. Поднимали без лекции про траекторию. Без них предисловие, REPL и эта станция сильно теряют смысл.
  ]
  v(0.55em)
  [
    Покойному *Валентину Фёдоровичу Слюсарчуку* — за то, что верил, когда гранит науки ещё был целый, а зубы — нет. Помогал прогрызать. Вера преподавателя не ставится в PATH, зато без неё многие не доходят до первой скобки.
  ]
  v(0.55em)
  [
    Его сыну *Мите*, а также *Вальке*, *Витале* и *Кириллу* — за волшебную юность и за то, что в трудную минуту не спрашивали «а зачем тебе это». Юность бывает разная. Их была magical, как в титрах, только без субтитров и без второго дубля.
  ]
  v(0.55em)
  [
    Друзьям по стрельбе из лука — *Стивену* и *Шону*. Без них жизнь была бы намного скучнее: сплошной Hibernate и ни одной стрелы, которая летит не туда. Лук — полезный спорт для человека, который целый день целится в скобку и всё равно промахивается. Стивен и Шон это терпят. Иногда даже хвалят. Иногда лучше не спрашивать, куда ушла стрела. После плохой группировки на мишени Spring кажется добрее. После плохого билда лук кажется добрее. Так и живём: два вида промаха, одни и те же друзья.
  ]
  v(0.55em)
  [
    Покойному *Терри*, с которым мы ходили охотиться на индейку. Никого не поймали. Было весело. Индейка, насколько известно, тоже довольна. Если на той стороне есть лес — пусть там хотя бы клюёт. Мы со своей стороны клюшку не брали, только хорошую компанию и нулевой трофей, который всё равно вспоминается лучше некоторых зелёных тестов.
  ]
  v(0.55em)
  [
    *Мише Иванову* — другу и наставнику. Показал Linux, когда чёрное окно ещё казалось угрозой из фильма, и Lisp, когда скобки казались насмешкой. С тех пор я в этом чёрном окне живу и даже зову его мастерской. Новыми идеями вдохновлял без устали: emagent родился не из вакуума, а из разговоров, после которых хочется открыть Emacs, а не лечь лицом в стол. Если в книге станция «МОДУЛЬ» иногда умнее автора — это, скорее всего, эхо Миши. Если глупее — автор уже сам.
  ]
  v(0.55em)
  [
    *Сергею Петрову* — за долгие разговоры обо всём и больше. «Больше» — это когда уже не понятно, где быт, где Lisp, где вселенная, а чай остыл второй раз. И за безладовую гитару: когда скобки и люди не помогают, остаётся инструмент без ладов, на котором промах слышно сразу. В моменты слабости это честнее Hibernate. Такие разговоры не вставляются в резюме. Из них, тем не менее, торчат уши этой книги.
  ]
  v(0.55em)
  [
    Его сыну *Дане* — не за то, что он попросил написать книгу. Не просил. Идея жила давно, ходила кругами, ждала повода. Даня стал поводом и подопытным учеником: живой человек, которому можно объяснить, что такое переменная, а не воображаемый джун из слайда. Если ты это читаешь — кивни Дане. Он не виноват в объёме. Виноваты скобки и упрямство.
  ]
  v(0.7em)
  [
    И всем-всем-всем, кто встречался на пути и кого здесь перечислить невозможно. Если начать — книга забудет, про что она. Она про скобки и Java. Люди — в жизни. Спасибо, что были.
  ]
  v(0.55em)
  [
    Если кого-то забыл — напишите. Второе издание. Грок в благодарности не входит: он не ходит, индейку не пугает и безладовую гитару не настроит. Зато скобки ставит. Иногда даже те, которые просили.
  ]
}
